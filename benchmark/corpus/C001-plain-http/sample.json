{
  "id": "C001-plain-http",
  "category": "config-supply-chain",
  "name": "Remote MCP server over cleartext HTTP",
  "source": "arxiv-2509.24272",
  "reference": "https://arxiv.org/abs/2509.24272",
  "artifacts": [
    {
      "kind": "server-config",
      "server": {
        "name": "legacy-remote",
        "client": "claude-desktop",
